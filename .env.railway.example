# Production Environment Variables for Railway

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=generate-a-random-secret-key-here

# Email Configuration (Gmail SMTP)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password_16_chars

# Notes:
# - SENDER_PASSWORD must be a Gmail App Password (not your regular password)
# - Generate App Password at: https://myaccount.google.com/apppasswords
# - SECRET_KEY should be a random string (use: python -c "import secrets; print(secrets.token_hex(32))")
# - Railway automatically provides PORT variable
