SECRET_KEY=your_secure_secret_key
# Used to encrypt and decrypt stored email account passwords in the database
FERNET_KEY=your_fernet_encryption_key_here

# Used to build full tracking URLs. Essential for Cloudflare tunnelling (e.g. BASE_URL=https://my-tunnel.trycloudflare.com)
BASE_URL=http://127.0.0.1:5002

# Optional Default Fallback Email
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
